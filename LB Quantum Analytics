# --- ALGORITHME DE CONVERGENCE (65-75% de probabilité) ---
@st.cache_data(ttl=3600)
def generate_signals():
    # Liste de départ équilibrée (Tech, Finance, Consommation)
    tickers = ["AAPL", "MSFT", "AMZN", "NVDA", "GOOGL", "META", "TSLA", "JPM", "V", "MA", "AVGO", "COST", "NFLX", "AMD", "WMT", "BRK-B", "LLY", "UNH"]
    data_output = []
    
    for t in tickers:
        try:
            df = yf.download(t, period="6mo", interval="1d", progress=False)
            # Nettoyage des colonnes MultiIndex de yfinance
            df.columns = [col[0] if isinstance(col, tuple) else col for col in df.columns]
            
            if df.empty: continue
            
            # 1. Calcul du RSI (14 jours)
            delta = df['Close'].diff()
            gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
            loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
            rs = gain / loss
            rsi = 100 - (100 / (1 + rs))
            current_rsi = rsi.iloc[-1]
            
            # 2. Moyenne Mobile 50 jours (Tendance)
            sma_50 = df['Close'].rolling(window=50).mean().iloc[-1]
            price = df['Close'].iloc[-1]
            
            # 3. Calcul de l'Indice de Confiance
            score = 50 
            # Bonus si le prix est au-dessus de la tendance
            if price > sma_50: score += 15 
            # Bonus si l'action est "sous-cotée" (RSI bas)
            if current_rsi < 40: score += 20 
            # Malus si l'action est en surchauffe (RSI haut)
            if current_rsi > 70: score -= 20 
            
            # Détermination du signal pro
            if score >= 70: signal = "🟢 ACHAT FORT"
            elif score >= 60: signal = "🔼 ACHAT"
            elif score <= 40: signal = "🔻 VENTE"
            else: signal = "⚪ NEUTRE"
            
            data_output.append({
                "Actif": t,
                "Prix ($)": round(float(price), 2),
                "Indice de Confiance": f"{min(score, 98)}%",
                "Signal": signal
            })
        except: continue
    return pd.DataFrame(data_output)

